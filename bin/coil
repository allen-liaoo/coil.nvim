#!/usr/bin/env bash
# coil: Neovim as a file manager. Starts Neovim in coil's standalone mode, which opens the column
# view for the directory arguments:
#
#   coil [--cwd-file <path>] [nvim arguments...]
#
# --cwd-file <path>: on exit, write the last directory to <path> (see docs/shell-integration.md).
# Everything else goes to Neovim. Runs `nvim` from PATH; set $COIL_NVIM_PROGRAM for another.
set -euo pipefail

nvim_program="${COIL_NVIM_PROGRAM:-nvim}"
# Only from --cwd-file, never inherited
unset COIL_CWD_FILE

args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --cwd-file)
      if [ $# -lt 2 ]; then
        echo "coil: --cwd-file needs a path" >&2
        exit 2
      fi
      export COIL_CWD_FILE="$2"
      shift 2
      ;;
    --cwd-file=*)
      export COIL_CWD_FILE="${1#*=}"
      shift
      ;;
    --)
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

# ${args[@]+...}: bash 3.2 (macOS) treats an empty array as unset under set -u
exec "$nvim_program" --cmd "let g:coil_standalone = 1" ${args[@]+"${args[@]}"}
